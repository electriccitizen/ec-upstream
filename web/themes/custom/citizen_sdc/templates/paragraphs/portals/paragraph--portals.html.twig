{# Builds the portals SDC `items` array from the field_portals formatter
   output, so the link subfield arrives already resolved by its url_plain
   formatter setting. #}
{% set items = [] %}
{% for delta, row in content.field_portals %}
  {% if delta|first != '#' and row['#items']['image'] is defined %}
    {% set subfield = row['#items'] %}
    {% set items = items|merge([{
      id: paragraph.id.value ~ '-' ~ (delta + 1),
      link: { url: subfield['link']['#value']['#plain_text']|default('') },
      image: subfield['image']['#value'],
      headline: subfield['headline']['#value']['#markup']|default(''),
      long_text: subfield['additional_text'] is defined ? subfield['additional_text']['#value'] : null,
    }]) %}
  {% endif %}
{% endfor %}

{% if items|length > 0 %}
  {{ include('citizen_sdc:portals', {
    attr: attributes,
    title: paragraph.field_widget_title.value,
    items: items,
  }, with_context = false) }}
{% endif %}

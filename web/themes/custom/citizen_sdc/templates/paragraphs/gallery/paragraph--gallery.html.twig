{% set gallery_type = paragraph.field_gallery_type.value == '1' ? 'lightbox' : 'slider' %}

{% set items = [] %}
{% for item in paragraph.field_gallery %}
  {% if item.gallery_image > 0 %}
    {% set thumb = drupal_entity('media', item.gallery_image, 'large_thumb')|render %}
    {% if thumb|trim is not empty %}
      {% set items = items|merge([{
        id: item.gallery_image,
        thumb: thumb,
        full: drupal_entity('media', item.gallery_image, 'slideshow')|render,
        caption: item.caption ?? '',
      }]) %}
    {% endif %}
  {% endif %}
{% endfor %}

{% if items|length > 0 %}
  {{ include('citizen_sdc:gallery', {
    attr: attributes,
    title: paragraph.field_widget_title.value,
    type: gallery_type,
    gallery_id: paragraph.id.value,
    items: items,
  }, with_context = false) }}
{% endif %}
